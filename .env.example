# Copy this file to `.env` (same folder as docker-compose.yml) and adjust.
# `.env` is gitignored — never commit real values.

# Host directory where the SQLite DB lives (bind-mounted to /app/data).
# Local dev default is ./data. On the Raspberry Pi set it to CasaOS AppData:
#   DATA_DIR=/DATA/AppData/portfolio-tracker
DATA_DIR=./data

# --- Optional HTTP Basic Auth ---
# Leave APP_PASSWORD empty to disable auth (the app is open — fine only behind
# a VPN/trusted network). Set a password to require a login on every request.
APP_USERNAME=admin
APP_PASSWORD=

# --- Debug endpoints ---
# Leave empty in normal use. Set to 1 only while troubleshooting PDF imports;
# it exposes /api/debug/cashflows and /api/epf/debug-pdf.
ENABLE_DEBUG_ENDPOINTS=

# --- Read-only MCP server for AI tools (Claude / ChatGPT / Gemini) ---
# Lets AI tools read your portfolio for insights. Off unless ENABLE_MCP=1.
# Read-only + PII-stripped, but remember the AI model is cloud-hosted, so whatever
# it analyses is sent to the provider. Keep this behind the VPN. See docs/mcp.md.
ENABLE_MCP=
# Bearer token required on the /mcp HTTP endpoint. Generate a long random secret, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Strongly recommended whenever ENABLE_MCP=1. Empty = endpoint open (VPN only!).
MCP_TOKEN=
# Comma-separated Host allowlist for DNS-rebinding protection. Add the address you
# reach the app on, e.g. MCP_ALLOWED_HOSTS=<host>:8000  (or a Twingate name).
# localhost/127.0.0.1 are always allowed. Use "*" to disable host checking (OK with
# a VPN + MCP_TOKEN). Leave empty if you only connect from localhost.
MCP_ALLOWED_HOSTS=

# --- Off-device backup to Nextcloud (used by scripts/backup.sh) ---
# Uploads the DB via WebDAV so it registers in Nextcloud and syncs to your
# devices. Leave empty to skip. NEXTCLOUD_APP_PASSWORD must be a Nextcloud
# *app password* (Settings > Security > "Create new app password"), NOT your
# account password — it is a revocable token.
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_REMOTE_DIR=Backups/portfolio
