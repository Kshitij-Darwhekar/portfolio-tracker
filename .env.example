# Copy this file to `.env` (same folder as docker-compose.yml) and adjust.
# `.env` is gitignored — never commit real values.

# Host directory where the SQLite DB lives (bind-mounted to /app/data).
# Local dev default is ./data. On the Raspberry Pi set it to CasaOS AppData:
#   DATA_DIR=/DATA/AppData/portfolio-tracker
DATA_DIR=./data

# --- Optional HTTP Basic Auth ---
# Leave APP_PASSWORD empty to disable auth (the app is open — fine only behind
# a VPN/trusted network). Set a password to require a login on every request.
APP_USERNAME=admin
APP_PASSWORD=

# --- Debug endpoints ---
# Leave empty in normal use. Set to 1 only while troubleshooting PDF imports;
# it exposes /api/debug/cashflows and /api/epf/debug-pdf.
ENABLE_DEBUG_ENDPOINTS=
